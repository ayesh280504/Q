{
  "expo": {
    "name": "Q Booth",
    "slug": "q-booth",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "qbooth",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.q.booth"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "app.q.booth"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
