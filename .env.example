# Cloud API
PORT=8787
# Supabase Auth (JWT verification on API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# For phone testing: use your LAN IP, e.g. http://192.168.0.155:5173 (ipconfig)
Q_CROWD_URL=http://localhost:5173
Q_WEB_URL=http://localhost:5174
Q_DATA_DIR=./data

# Crowd web (browser)
VITE_Q_API_URL=http://localhost:8787

# Marketing / community web — Supabase Auth
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Desktop app
VITE_Q_API_URL=http://localhost:8787
VITE_Q_WEB_URL=http://localhost:5174
# LAN crowd URL for QR codes (optional — desktop auto-detects Wi‑Fi IP when unset)
VITE_Q_CROWD_LAN_URL=http://192.168.0.155:5173
