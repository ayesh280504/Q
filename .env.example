# Cloud API
PORT=8787

# Spotify — crowd open search + BPM/key on requests (optional)
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Supabase Auth (JWT verification on API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# For phone testing: use your LAN IP, e.g. http://192.168.0.155:5173 (ipconfig)
Q_CROWD_URL=http://localhost:5173
Q_WEB_URL=http://localhost:5174
Q_DATA_DIR=./data

# Tauri auto-updater (server side) — set on Render for /desktop/update.json
# Q_GITHUB_REPO=owner/repo
# Q_GITHUB_TOKEN=ghp_...   # only required if repo is private

# Crowd web (browser)
VITE_Q_API_URL=http://localhost:8787
VITE_Q_WEB_URL=http://localhost:5174

# Marketing / community web — Supabase Auth
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_ENABLE_GOOGLE=true

# Web — hosted booth installers (GitHub Release or CDN). Redeploy q-web after setting.
# VITE_Q_INSTALLER_WINDOWS=https://github.com/ayesh280504/Q/releases/download/v0.2.0/Q_0.2.0_x64-setup.exe
# VITE_Q_INSTALLER_MAC=https://github.com/ayesh280504/Q/releases/download/v0.2.0/Q_0.2.0_x64.dmg

# Desktop app
VITE_Q_API_URL=http://localhost:8787
VITE_Q_WEB_URL=http://localhost:5174
# LAN crowd URL for QR codes (optional — desktop auto-detects Wi‑Fi IP when unset)
VITE_Q_CROWD_LAN_URL=http://192.168.0.155:5173

# Q Booth mobile (Expo) — run `npm run sync:env` after changing Q_CROWD_URL
EXPO_PUBLIC_Q_API_URL=http://192.168.0.155:8787
EXPO_PUBLIC_Q_CROWD_URL=http://192.168.0.155:5173
